
*.DS_Store

# PlatformIO build output and downloaded lib dependencies.
# Covers every firmware project (.pio/build, .pio/libdeps, ...); the previous
# "*.pio/build/" pattern missed libdeps and the projects without their own
# .gitignore (remoteid-c5-5g, rx5808-detection).
.pio/

*.vscode/

# iOS prototype: everything XcodeGen derives from ios-mapper/project.yml
ios-mapper/*.xcodeproj/
ios-mapper/MeshMapper/Info.plist
ios-mapper/MeshMapper/MeshMapper.entitlements
ios-mapper/**/xcuserdata/
ios-mapper/DerivedData/

# Python bytecode
__pycache__/
*.py[cod]

# mesh-mapper.py runtime output (per-session logs, exports and KML)
mapper.log
cumulative.kml
cumulative_detections.csv
detections_*.csv
detections_*.kml
